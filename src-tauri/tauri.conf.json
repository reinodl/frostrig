{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FrostRig",
  "version": "0.20.0",
  "identifier": "io.github.frostrig",
  "build": {
    "beforeDevCommand": "npm run dev:ui",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:ui",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FrostRig",
        "width": 1280,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 680,
        "backgroundColor": "#09060A"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"]
  }
}
